# مشخص کردن که برنامه روی VPS اجرا می‌شود
VPS_MODE=true

# اتصال MongoDB
MONGODB_URI=mongodb://localhost:27017/hiarchitect

# یا استفاده از MongoDB Cloud
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# مسیر پوشه فایل‌ها در VPS
FILES_DIR=/root/hiarchitectweb/public/files

# URL اصلی سایت
SITE_URL=https://hiarchitectweb.com